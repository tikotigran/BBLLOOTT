rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isRecentServerTime(ts) {
      return ts is timestamp
        && ts >= request.time - duration.value(120, 's')
        && ts <= request.time + duration.value(120, 's');
    }

    function isTimestampOrServerTime(ts) {
      return ts == request.time || ts is timestamp;
    }

    function isIncomingServerTime(ts) {
      return ts == request.time
        || (
          ts is timestamp
          && ts >= request.time - duration.value(60, 's')
          && ts <= request.time + duration.value(60, 's')
        );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidRoomCode(id) {
      return id is string && id.size() >= 4 && id.size() <= 16 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidOptionalId(id) {
      return id is string && id.size() <= 128 && (id == '' || id.matches('^[a-zA-Z0-9_-]+$'));
    }

    function isValidShortId(id) {
      return id is string && id.size() <= 12 && id.matches('^[0-9]{7}$');
    }

    function isValidOptionalShortId(id) {
      return id is string && id.size() <= 12 && (id == '' || id.matches('^[0-9]{7}$'));
    }

    function isValidCardMap(card) {
      return card is map
        && card.keys().hasAll(['id', 'suit', 'rank'])
        && card.keys().hasOnly(['id', 'suit', 'rank'])
        && card.id is string && card.id.size() >= 3 && card.id.size() <= 24
        && card.suit is string && card.suit.size() >= 4 && card.suit.size() <= 12
        && card.rank is string && card.rank.size() >= 1 && card.rank.size() <= 4;
    }

    // --- Validation Blueprint: UserProfile ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'nickname', 'shortId', 'avatarId', 'balance',
          'gamesPlayed', 'wins', 'registrationComplete', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'nickname', 'shortId', 'avatarId', 'balance',
          'gamesPlayed', 'wins', 'registrationComplete', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.nickname is string && data.nickname.size() >= 2 && data.nickname.size() <= 24
        && isValidShortId(data.shortId)
        && data.avatarId is string && data.avatarId.size() <= 24
        && data.avatarId in ['classic', 'emerald', 'crimson', 'gold']
        && data.balance is number && data.balance >= 0 && data.balance <= 1000000000
        && data.gamesPlayed is number && data.gamesPlayed >= 0 && data.gamesPlayed <= 1000000
        && data.wins is number && data.wins >= 0 && data.wins <= data.gamesPlayed
        && data.registrationComplete is bool
        && isTimestampOrServerTime(data.createdAt)
        && isTimestampOrServerTime(data.updatedAt);
    }

    // --- Validation Blueprint: GameRoom (compact 17 top-level keys + bounded sub-maps) ---
    function isValidRoomConfig(cfg) {
      return cfg is map
        && cfg.keys().hasAll([
          'tableId', 'gameLimit', 'betAmount',
          'allowHighCombos', 'allCombinationsDisabled', 'turnTimeLimit'
        ])
        && cfg.keys().hasOnly([
          'tableId', 'gameLimit', 'betAmount',
          'allowHighCombos', 'allCombinationsDisabled', 'turnTimeLimit'
        ])
        && cfg.tableId is number && cfg.tableId >= 100000 && cfg.tableId <= 2147483647
        && cfg.gameLimit is number && cfg.gameLimit in [51, 101, 151]
        && cfg.betAmount is number && cfg.betAmount >= 1000 && cfg.betAmount <= 100000
        && cfg.allowHighCombos is bool
        && cfg.allCombinationsDisabled is bool
        && cfg.turnTimeLimit is number && cfg.turnTimeLimit in [15, 20, 30];
    }

    function isValidRoomRound(rnd) {
      return rnd is map
        && rnd.keys().hasAll([
          'roundNumber', 'dealerRole', 'turnRole', 'phase',
          'trump', 'bidderRole', 'lastWinnerRole', 'pendingExtraDrawRole'
        ])
        && rnd.keys().hasOnly([
          'roundNumber', 'dealerRole', 'turnRole', 'phase',
          'trump', 'bidderRole', 'lastWinnerRole', 'pendingExtraDrawRole'
        ])
        && rnd.roundNumber is number && rnd.roundNumber >= 0 && rnd.roundNumber <= 100
        && rnd.dealerRole is string && rnd.dealerRole.size() <= 8 && rnd.dealerRole in ['host', 'guest']
        && rnd.turnRole is string && rnd.turnRole.size() <= 8 && rnd.turnRole in ['host', 'guest']
        && rnd.phase is string && rnd.phase.size() <= 24
        && rnd.phase in ['OFFERING_TRUMP', 'SUIT_SELECTION', 'PLAYING', 'RESULT', 'GAME_OVER']
        && rnd.trump is string && rnd.trump.size() <= 16
        && rnd.trump in ['', 'HEARTS', 'DIAMONDS', 'CLUBS', 'SPADES', 'NO_TRUMP']
        && rnd.bidderRole is string && rnd.bidderRole.size() <= 8 && rnd.bidderRole in ['', 'host', 'guest']
        && rnd.lastWinnerRole is string && rnd.lastWinnerRole.size() <= 8 && rnd.lastWinnerRole in ['', 'host', 'guest']
        && rnd.pendingExtraDrawRole is string && rnd.pendingExtraDrawRole.size() <= 8 && rnd.pendingExtraDrawRole in ['', 'host', 'guest'];
    }

    function isValidRoomScores(sc) {
      return sc is map
        && sc.keys().hasAll([
          'hostScore', 'guestScore', 'hostRoundScore',
          'guestRoundScore', 'hostCardCount', 'guestCardCount'
        ])
        && sc.keys().hasOnly([
          'hostScore', 'guestScore', 'hostRoundScore',
          'guestRoundScore', 'hostCardCount', 'guestCardCount'
        ])
        && sc.hostScore is number && sc.hostScore >= 0 && sc.hostScore <= 1000
        && sc.guestScore is number && sc.guestScore >= 0 && sc.guestScore <= 1000
        && sc.hostRoundScore is number && sc.hostRoundScore >= 0 && sc.hostRoundScore <= 1000
        && sc.guestRoundScore is number && sc.guestRoundScore >= 0 && sc.guestRoundScore <= 1000
        && sc.hostCardCount is number && sc.hostCardCount >= 0 && sc.hostCardCount <= 8
        && sc.guestCardCount is number && sc.guestCardCount >= 0 && sc.guestCardCount <= 8;
    }

    function isValidRoomBoard(brd) {
      return brd is map
        && brd.keys().hasAll([
          'offeredCard', 'deck', 'trickHostCard',
          'trickGuestCard', 'playedCards', 'roundBreakdown'
        ])
        && brd.keys().hasOnly([
          'offeredCard', 'deck', 'trickHostCard',
          'trickGuestCard', 'playedCards', 'roundBreakdown'
        ])
        && (brd.offeredCard == null || isValidCardMap(brd.offeredCard))
        && brd.deck is list && brd.deck.size() <= 24
        && (brd.deck.size() == 0 || isValidCardMap(brd.deck[0]))
        && (brd.trickHostCard == null || isValidCardMap(brd.trickHostCard))
        && (brd.trickGuestCard == null || isValidCardMap(brd.trickGuestCard))
        && brd.playedCards is list && brd.playedCards.size() <= 8
        && (brd.playedCards.size() == 0 || brd.playedCards[0] is map)
        && (brd.roundBreakdown == null || (brd.roundBreakdown is map && brd.roundBreakdown.size() <= 6));
    }

    function isValidRoomCombos(cmb) {
      return cmb is map
        && cmb.keys().hasAll([
          'hostAnnounced', 'guestAnnounced', 'hostDeclared', 'guestDeclared'
        ])
        && cmb.keys().hasOnly([
          'hostAnnounced', 'guestAnnounced', 'hostDeclared', 'guestDeclared'
        ])
        && cmb.hostAnnounced is list && cmb.hostAnnounced.size() <= 4
        && (cmb.hostAnnounced.size() == 0 || cmb.hostAnnounced[0] is map)
        && cmb.guestAnnounced is list && cmb.guestAnnounced.size() <= 4
        && (cmb.guestAnnounced.size() == 0 || cmb.guestAnnounced[0] is map)
        && cmb.hostDeclared is list && cmb.hostDeclared.size() <= 4
        && (cmb.hostDeclared.size() == 0 || cmb.hostDeclared[0] is map)
        && cmb.guestDeclared is list && cmb.guestDeclared.size() <= 4
        && (cmb.guestDeclared.size() == 0 || cmb.guestDeclared[0] is map);
    }

    function isValidRoomFlags(flg) {
      return flg is map
        && flg.keys().hasAll([
          'hostHasShown', 'guestHasShown', 'hostCanDeclare', 'guestCanDeclare',
          'hostCanShow', 'guestCanShow', 'hostBlot', 'guestBlot'
        ])
        && flg.keys().hasOnly([
          'hostHasShown', 'guestHasShown', 'hostCanDeclare', 'guestCanDeclare',
          'hostCanShow', 'guestCanShow', 'hostBlot', 'guestBlot'
        ])
        && flg.hostHasShown is bool
        && flg.guestHasShown is bool
        && flg.hostCanDeclare is bool
        && flg.guestCanDeclare is bool
        && flg.hostCanShow is bool
        && flg.guestCanShow is bool
        && flg.hostBlot is bool
        && flg.guestBlot is bool;
    }

    function isValidGameRoom(data) {
      return data.keys().hasAll([
          'roomCode', 'hostUid', 'hostName', 'hostShortId',
          'guestUid', 'guestName', 'guestShortId', 'status', 'winnerUid',
          'config', 'round', 'scores', 'board', 'combos', 'flags',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'roomCode', 'hostUid', 'hostName', 'hostShortId',
          'guestUid', 'guestName', 'guestShortId', 'status', 'winnerUid',
          'config', 'round', 'scores', 'board', 'combos', 'flags',
          'createdAt', 'updatedAt'
        ])
        && isValidRoomCode(data.roomCode)
        && isValidId(data.hostUid)
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 24
        && isValidShortId(data.hostShortId)
        && isValidOptionalId(data.guestUid)
        && data.guestName is string && data.guestName.size() <= 24
        && isValidOptionalShortId(data.guestShortId)
        && data.status is string && data.status.size() <= 16
        && data.status in ['waiting', 'playing', 'finished']
        && isValidOptionalId(data.winnerUid)
        && isValidRoomConfig(data.config)
        && isValidRoomRound(data.round)
        && isValidRoomScores(data.scores)
        && isValidRoomBoard(data.board)
        && isValidRoomCombos(data.combos)
        && isValidRoomFlags(data.flags)
        && isTimestampOrServerTime(data.createdAt)
        && isTimestampOrServerTime(data.updatedAt);
    }

    // --- Validation Blueprint: PlayerHand ---
    function isValidPlayerHand(data, playerId, roomId) {
      return data.keys().hasAll(['uid', 'roomId', 'cards', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'roomId', 'cards', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == playerId
        && isValidRoomCode(data.roomId)
        && data.roomId == roomId
        && data.cards is list && data.cards.size() <= 8
        && (data.cards.size() == 0 || isValidCardMap(data.cards[0]))
        && isTimestampOrServerTime(data.updatedAt);
    }

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isSignedIn() && isVerified() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() && isVerified() && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && isIncomingServerTime(incoming().createdAt)
        && isIncomingServerTime(incoming().updatedAt);
      allow update: if isSignedIn() && isVerified() && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().shortId == existing().shortId
        && !incoming().diff(existing()).affectedKeys().hasAny(['createdAt'])
        && isIncomingServerTime(incoming().updatedAt)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'nickname', 'avatarId', 'balance', 'gamesPlayed', 'wins', 'registrationComplete', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // --- Rooms Collection ---
    match /rooms/{roomId} {
      allow get: if isSignedIn() && isVerified() && isValidRoomCode(roomId)
        && (
          resource == null
          || existing().status == 'waiting'
          || existing().hostUid == request.auth.uid
          || existing().guestUid == request.auth.uid
        );
      allow list: if isSignedIn() && isVerified()
        && (
          resource.data.status == 'waiting'
          || resource.data.hostUid == request.auth.uid
          || resource.data.guestUid == request.auth.uid
        );
      allow create: if isSignedIn() && isVerified() && isValidRoomCode(roomId)
        && isValidGameRoom(incoming())
        && incoming().roomCode == roomId
        && incoming().hostUid == request.auth.uid
        && incoming().guestUid == ''
        && incoming().status == 'waiting'
        && incoming().winnerUid == ''
        && isIncomingServerTime(incoming().createdAt)
        && isIncomingServerTime(incoming().updatedAt);
      allow update: if isSignedIn() && isVerified() && isValidRoomCode(roomId)
        && isValidGameRoom(incoming())
        && existing().status != 'finished'
        && incoming().roomCode == existing().roomCode
        && incoming().hostUid == existing().hostUid
        && incoming().hostShortId == existing().hostShortId
        && incoming().config == existing().config
        && !incoming().diff(existing()).affectedKeys().hasAny(['createdAt'])
        && isIncomingServerTime(incoming().updatedAt)
        && (
          // Action 1: Any verified player joins an active open waiting room
          (
            existing().status == 'waiting'
            && existing().guestUid == ''
            && isRecentServerTime(existing().updatedAt)
            && request.auth.uid != existing().hostUid
            && incoming().guestUid == request.auth.uid
            && incoming().status == 'playing'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'guestUid', 'guestName', 'guestShortId', 'status', 'updatedAt'
            ])
          )
          ||
          // Action 2: Active participant updates room state during gameplay
          (
            existing().status == 'playing'
            && (request.auth.uid == existing().hostUid || request.auth.uid == existing().guestUid)
            && incoming().guestUid == existing().guestUid
            && incoming().guestName == existing().guestName
            && incoming().guestShortId == existing().guestShortId
            && incoming().status in ['playing', 'finished']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'winnerUid', 'round', 'scores', 'board', 'combos', 'flags', 'updatedAt'
            ])
          )
          ||
          // Action 3: Host cancels a waiting room before a guest joins
          (
            existing().status == 'waiting'
            && request.auth.uid == existing().hostUid
            && incoming().status == 'finished'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'updatedAt'
            ])
          )
          ||
          // Action 4: Host refreshes waiting room presence heartbeat
          (
            existing().status == 'waiting'
            && request.auth.uid == existing().hostUid
            && incoming().status == 'waiting'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'updatedAt'
            ])
          )
        );
      allow delete: if isSignedIn() && isVerified() && isValidRoomCode(roomId)
        && existing().status == 'waiting'
        && existing().hostUid == request.auth.uid;

      // --- Hands Subcollection (Master Gate + Owner-Only Read + Atomic Sync) ---
      match /hands/{playerId} {
        allow get: if isSignedIn() && isVerified()
          && isValidRoomCode(roomId) && isValidId(playerId)
          && request.auth.uid == playerId
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.guestUid == request.auth.uid
          );
        allow list: if false;
        allow create, update: if isSignedIn() && isVerified()
          && isValidRoomCode(roomId) && isValidId(playerId)
          && isValidPlayerHand(incoming(), playerId, roomId)
          && isIncomingServerTime(incoming().updatedAt)
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid
            || (
              get(/databases/$(database)/documents/rooms/$(roomId)).data.guestUid == request.auth.uid
              && request.auth.uid == playerId
            )
          )
          && isIncomingServerTime(getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.updatedAt);
        allow delete: if false;
      }
    }
  }
}
