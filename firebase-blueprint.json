{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered player account with display nickname, short ID, avatar, balance, and game statistics.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nickname": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "shortId": {
          "type": "string",
          "minLength": 7,
          "maxLength": 12,
          "pattern": "^[0-9]{7}$"
        },
        "avatarId": {
          "type": "string",
          "enum": ["classic", "emerald", "crimson", "gold"],
          "maxLength": 24
        },
        "balance": {
          "type": "number"
        },
        "gamesPlayed": {
          "type": "number"
        },
        "wins": {
          "type": "number"
        },
        "registrationComplete": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "nickname",
        "shortId",
        "avatarId",
        "balance",
        "gamesPlayed",
        "wins",
        "registrationComplete",
        "createdAt",
        "updatedAt"
      ]
    },
    "GameRoom": {
      "title": "GameRoom",
      "description": "Online 2-player Blot room state shared between host and guest with modular sub-maps.",
      "type": "object",
      "properties": {
        "roomCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "hostShortId": {
          "type": "string",
          "maxLength": 12,
          "pattern": "^[0-9]{7}$"
        },
        "guestUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^$|^[a-zA-Z0-9_\\-]+$"
        },
        "guestName": {
          "type": "string",
          "maxLength": 24
        },
        "guestShortId": {
          "type": "string",
          "maxLength": 12,
          "pattern": "^$|^[0-9]{7}$"
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "playing", "finished"],
          "maxLength": 16
        },
        "winnerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^$|^[a-zA-Z0-9_\\-]+$"
        },
        "config": {
          "type": "object"
        },
        "round": {
          "type": "object"
        },
        "scores": {
          "type": "object"
        },
        "board": {
          "type": "object"
        },
        "combos": {
          "type": "object"
        },
        "flags": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "roomCode",
        "hostUid",
        "hostName",
        "hostShortId",
        "guestUid",
        "guestName",
        "guestShortId",
        "status",
        "winnerUid",
        "config",
        "round",
        "scores",
        "board",
        "combos",
        "flags",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlayerHand": {
      "title": "PlayerHand",
      "description": "Private cards belonging exclusively to a single player inside an online Blot room.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "cards": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "roomId", "cards", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private player account profile (no PII email/phone stored; owner-only access)."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/GameRoom" },
      "description": "Online 2-player Blot table state indexed by invite room code."
    },
    "/rooms/{roomId}/hands/{playerId}": {
      "schema": { "$ref": "#/entities/PlayerHand" },
      "description": "Private hand subcollection readable exclusively by the owning player."
    }
  }
}
